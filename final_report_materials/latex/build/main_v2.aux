\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Building labels on real data. (1) A drone photo of a cotton field. (2) Its automatic pseudo-label from the patch classifier: rough, with many false drought pixels, and uncertain pixels left as \emph  {ignore}. (3) Screenshot of the custom annotation tool correcting one tile (left: original, right: editable labels; tile of another photo).}}{12}{figure.caption.14}\protected@file@percent }
\newlabel{fig:u_labels}{{9}{12}{Building labels on real data. (1) A drone photo of a cotton field. (2) Its automatic pseudo-label from the patch classifier: rough, with many false drought pixels, and uncertain pixels left as \emph {ignore}. (3) Screenshot of the custom annotation tool correcting one tile (left: original, right: editable labels; tile of another photo)}{figure.caption.14}{}}
