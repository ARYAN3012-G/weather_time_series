\@writefile{toc}{\contentsline {subsection}{\numberline {7.4}Orthomosaic inference, area and decision}{13}{subsection.7.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces How prediction stitching works (shown on one drone photo; an orthomosaic is processed the same way). (a) The image is cut into overlapping $1024$\,px tiles. (b) Each tile's class probabilities are weighted by a Hann window (high in the centre, low at the edges, clamped at 0.1), so tile borders do not create seams. (c) Only one 1024-row band of probabilities is kept in memory; rows above it are final.}}{14}{figure.caption.17}\protected@file@percent }
\newlabel{fig:u_stitch}{{12}{14}{How prediction stitching works (shown on one drone photo; an orthomosaic is processed the same way). (a) The image is cut into overlapping $1024$\,px tiles. (b) Each tile's class probabilities are weighted by a Hann window (high in the centre, low at the edges, clamped at 0.1), so tile borders do not create seams. (c) Only one 1024-row band of probabilities is kept in memory; rows above it are final}{figure.caption.17}{}}
